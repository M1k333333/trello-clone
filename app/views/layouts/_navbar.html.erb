<nav class="bg-white border-gray-200">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <%= link_to root_path do %>
        <%= image_tag "trello_logo.png", class: "h-8" %>
    <% end %>
    <% if user_signed_in? %>
    <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse">
        <% if controller_name == "boards" && action_name == "show" %>
            <%= link_to new_board_list_path(@board) do %>
                <button type="button" class="cursor-pointer text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">+ New List</button>
            <% end %>
        <% else %>
            <%= link_to new_board_path do %>
                <button type="button" class="cursor-pointer text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">+ New Board</button>
            <% end %>
        <% end %>
        <%= link_to "Log out", destroy_user_session_path, data: { "turbo-method": :delete }, class:"text-gray-700 hover:text-gray-900 text-sm px-5 py-2 text-center" %>
    </div>
    <%# <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-cta">
        <ul class="flex flex-col font-medium p-4 md:p-0 mt-4 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0">
            <li>
                <a href="#" class="link text-sm py-2 px-3 md:p-0" aria-current="page">Dashboard</a>
            </li>
        </ul>
    </div> %>
    <% else %>
    <div class="flex items-center space-x-4 rtl:space-x-reverse">
        <%= link_to new_user_registration_path, class: "text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" do %>
            Register
        <% end %>
        <%= link_to new_user_session_path, class: "text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-4 py-2 text-center" do %>
            Login
        <% end %>
    </div>
    <% end %>
  </div>
</nav>